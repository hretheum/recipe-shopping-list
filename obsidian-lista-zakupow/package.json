{
	"name": "obsidian-lista-zakupow",
	"version": "0.1.0",
	"description": "Wtyczka Obsidian: składniki z przepisów do listy zakupów Bring! (normalizacja i sumowanie przez LLM)",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/build.mjs && node --test test/*.test.mjs test/*.test.cjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3"
	}
}
